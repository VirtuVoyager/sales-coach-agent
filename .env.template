# ==========================================
# Application Settings
# ==========================================
ENVIRONMENT=development
LLM_PROVIDER=groq  # Set to "azure" or "groq"

# ==========================================
# Groq Configuration (Fast & Open Source)
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama3-70b-8192

# ==========================================
# Azure OpenAI Configuration
# ==========================================
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ==========================================
# Database Configuration
# ==========================================
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=sales_simulator_db

# ==========================================
# Opik Observability (Local Open-Source)
# ==========================================
# Points the SDK to your local docker container instead of the cloud
OPIK_URL_OVERRIDE=http://localhost:5173/api
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=sales-simulator
